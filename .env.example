# Quigent Voice AI API Configuration
# Obtain your API key from the Quigent enterprise dashboard (https://quigent.com)
QUIGENT_API_KEY=qgt_live_your_api_key_here

# Base URL for Quigent Voice API
QUIGENT_API_BASE_URL=https://api.quigent.com/v1

# Webhook Secret for signature verification
QUIGENT_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Local Webhook Server Port
PORT=8000
